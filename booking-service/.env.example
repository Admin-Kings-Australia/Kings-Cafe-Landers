# Supply secrets via your host's environment settings, never commit them.
STAFF_PASSWORD=
DATABASE_PATH=/data/bookings.sqlite
NODE_ENV=production
HOST=0.0.0.0
PORT=4174
# Include the staff site AND every allowed landing-page origin, without trailing slashes.
ALLOWED_ORIGINS=https://bookings.example.com,https://www.example.com
# Only enable behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
